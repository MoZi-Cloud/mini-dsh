{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mini-dsh.local/schemas/plan-v1.schema.json",
  "title": "mini-DSH Plan v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "plan"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "plan": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "key",
        "name",
        "version",
        "status",
        "project",
        "objectives",
        "targets",
        "phases"
      ],
      "properties": {
        "key": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "draft",
            "proposed",
            "approved",
            "active",
            "superseded",
            "archived"
          ]
        },
        "project": {
          "type": "object",
          "required": [
            "key",
            "name",
            "baseline"
          ],
          "additionalProperties": true,
          "properties": {
            "key": {
              "type": "string"
            },
            "name": {
              "type": "string"
            },
            "baseline": {
              "type": "object"
            }
          }
        },
        "roles": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "key",
              "kind"
            ],
            "additionalProperties": true
          }
        },
        "objectives": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "key",
              "kind",
              "title",
              "description"
            ],
            "additionalProperties": true
          }
        },
        "targets": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "key",
              "kind",
              "assertion"
            ],
            "additionalProperties": true
          }
        },
        "phases": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/phase"
          }
        },
        "decisions": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "key",
              "title",
              "question",
              "status"
            ],
            "additionalProperties": true
          }
        },
        "resources": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "key",
              "kind",
              "name",
              "status",
              "constraints"
            ],
            "additionalProperties": true
          }
        },
        "workflows": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "key",
              "name",
              "nodes",
              "edges"
            ],
            "additionalProperties": true
          }
        }
      }
    }
  },
  "$defs": {
    "phase": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "key",
        "ordinal",
        "title",
        "status",
        "milestones"
      ],
      "properties": {
        "key": {
          "type": "string"
        },
        "ordinal": {
          "type": "integer",
          "minimum": 0
        },
        "title": {
          "type": "string"
        },
        "status": {
          "type": "string"
        },
        "milestones": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/milestone"
          }
        }
      }
    },
    "milestone": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "key",
        "title",
        "workItems"
      ],
      "properties": {
        "key": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "workItems": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/workItem"
          }
        }
      }
    },
    "workItem": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "key",
        "type",
        "executorKind",
        "title",
        "status"
      ],
      "properties": {
        "key": {
          "type": "string"
        },
        "type": {
          "type": "string"
        },
        "executorKind": {
          "enum": [
            "AGENT",
            "OWNER",
            "HUMAN",
            "SYSTEM",
            "EXTERNAL"
          ]
        },
        "requestedRole": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "status": {
          "type": "string"
        },
        "dependsOn": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "externalBlockers": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "acceptance": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/acceptance"
          }
        },
        "designChanges": {
          "type": "array",
          "items": {
            "type": "object"
          }
        }
      }
    },
    "acceptance": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "key",
        "kind",
        "description",
        "verifier"
      ],
      "properties": {
        "key": {
          "type": "string"
        },
        "kind": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "verifier": {
          "type": "object"
        }
      }
    }
  }
}